# Bite2Eat Copilot feature flags
AI_ENABLED="true"
NEXT_PUBLIC_AI_ENABLED="true"

# Reserved for the next milestone with live LLM responses
OPENAI_API_KEY=

# PostgreSQL
DATABASE_URL="postgresql://takeai:takeai_dev_password@localhost:5432/takeai?schema=public"

# Used by health/status pages to label the environment
NEXT_PUBLIC_APP_ENV="development"

# Generate a unique value before production (32+ characters)
AUTH_SECRET="takeai-development-secret-change-before-production-2026"

# Stripe Checkout (use test keys locally)
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Bite2Eat Copilot real AI (server-side only — never expose this key in NEXT_PUBLIC variables)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"
